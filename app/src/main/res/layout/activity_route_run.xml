<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.baidu.mapapi.map.MapView
        android:id="@+id/map_run"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/route_run_float_tip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:layout_above="@+id/route_run_bottom_panel"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_alignParentStart="true"
        android:layout_alignParentEnd="true"
        app:cardCornerRadius="12dp"
        app:cardElevation="10dp"
        app:strokeColor="@color/colorOutlineVariant"
        app:strokeWidth="1dp">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="14dp"
            android:paddingEnd="6dp">
            <TextView
                android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                android:textColor="?android:attr/textColorPrimary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/route_run_float_tip"
                android:layout_weight="1"/>
            <ImageButton
                android:id="@+id/route_run_float_tip_close"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="8dp"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:scaleType="centerInside"
                android:contentDescription="@string/route_run_float_tip_close"
                app:srcCompat="@drawable/ic_close"
                app:tint="?android:attr/textColorSecondary"/>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/route_run_bottom_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        app:cardCornerRadius="12dp"
        app:cardElevation="6dp"
        app:strokeWidth="0dp">
        <LinearLayout
            android:orientation="vertical"
            android:background="?attr/colorSurface"
            android:padding="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                android:id="@+id/tv_current_route"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="当前路线: 未选择"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp">
                <TextView
                    android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="速度:"/>
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="72dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    app:boxBackgroundMode="outline">
                    <com.google.android.material.textfield.TextInputEditText
                        android:gravity="center"
                        android:id="@+id/et_run_speed"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="3.8"
                        android:inputType="numberDecimal"/>
                </com.google.android.material.textfield.TextInputLayout>
                <TextView
                    android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="m/s"
                    android:layout_marginStart="4dp"/>
                <TextView
                    android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="循环:"
                    android:layout_marginStart="12dp"/>
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="64dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    app:boxBackgroundMode="outline">
                    <com.google.android.material.textfield.TextInputEditText
                        android:gravity="center"
                        android:id="@+id/et_loop_count"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="10"
                        android:inputType="number"/>
                </com.google.android.material.textfield.TextInputLayout>
                <TextView
                    android:textAppearance="@style/TextAppearance.Material3.LabelMedium"
                    android:textColor="?android:attr/textColorSecondary"
                    android:id="@+id/tv_ws_status_hint"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp">
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_run_load"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="选路线"
                    style="@style/Widget.Material3.Button.TonalButton"/>
                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1"/>
                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/cb_speed_float"
                    app:thumbTint="@color/white"
                    app:trackTint="@color/route_action_track"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="速度浮动"/>
            </LinearLayout>
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_run_toggle"
                app:backgroundTint="@color/route_action"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="52dp"
                android:text="开始模拟"
                style="@style/Widget.Material3.Button"/>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</RelativeLayout>
