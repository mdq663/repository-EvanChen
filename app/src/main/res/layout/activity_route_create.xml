<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.baidu.mapapi.map.MapView
        android:id="@+id/map_create"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.google.android.material.card.MaterialCardView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_centerHorizontal="true"
        app:cardBackgroundColor="#99000000"
        app:cardCornerRadius="8dp"
        app:cardElevation="0dp">
        <TextView
            android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
            android:textColor="@color/colorOnPrimary"
            android:padding="8dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="点击地图绘制路线"/>
    </com.google.android.material.card.MaterialCardView>
    <ImageButton
        android:id="@+id/btn_create_location"
        android:background="@drawable/circle_shape_bg"
        android:padding="8dp"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginBottom="20dp"
        android:src="@drawable/ic_position"
        android:scaleType="centerInside"
        android:layout_above="@+id/layout_bottom_control"
        android:contentDescription="@null"
        android:layout_marginStart="20dp"
        android:layout_alignParentStart="true"/>
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/layout_bottom_control"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        app:cardCornerRadius="12dp"
        app:cardElevation="6dp">
        <LinearLayout
            android:orientation="horizontal"
            android:background="?attr/colorSurface"
            android:padding="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_create_clear"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="清除重画"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                style="@style/Widget.Material3.Button.OutlinedButton"/>
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_create_save"
                app:backgroundTint="@color/route_action"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="保存路线"
                android:layout_weight="1"
                style="@style/Widget.Material3.Button"/>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</RelativeLayout>
