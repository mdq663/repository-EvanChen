<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="?attr/colorSurface"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar_main"
        android:background="@color/colorPrimary"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:popupTheme="@style/AppTheme.PopupOverlay"
        app:titleTextColor="@android:color/white"/>
    <androidx.core.widget.NestedScrollView
        android:id="@+id/home_scroll"
        android:scrollbars="none"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:layout_weight="1"
        android:overScrollMode="never">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/home_scroll_outer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/home_scroll_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.google.android.material.button.MaterialButton
                    android:textAppearance="@style/TextAppearance.Material3.TitleLarge"
                    android:textColor="@color/colorOnPrimary"
                    android:id="@+id/card_nfc_tools"
                    android:paddingTop="14dp"
                    android:paddingBottom="14dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:minHeight="64dp"
                    android:text="@string/nfc_tools_title"
                    app:backgroundTint="@color/colorPrimary"
                    app:cornerRadius="16dp"
                    app:elevation="6dp"
                    app:icon="@drawable/ic_key"
                    app:iconGravity="textStart"
                    app:iconPadding="14dp"
                    app:iconSize="32dp"
                    app:iconTint="@color/colorOnPrimary"
                    app:rippleColor="@color/colorPrimaryContainer"
                    style="@style/Widget.Material3.Button"/>
                <com.google.android.material.button.MaterialButton
                    android:textAppearance="@style/TextAppearance.Material3.TitleLarge"
                    android:textColor="@color/colorOnPrimary"
                    android:id="@+id/card_route_run"
                    android:paddingTop="14dp"
                    android:paddingBottom="14dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:minHeight="64dp"
                    android:text="路线模拟"
                    app:backgroundTint="@color/colorPrimary"
                    app:cornerRadius="16dp"
                    app:elevation="6dp"
                    app:icon="@drawable/ic_run"
                    app:iconGravity="textStart"
                    app:iconPadding="14dp"
                    app:iconSize="32dp"
                    app:iconTint="@color/colorOnPrimary"
                    app:rippleColor="@color/colorPrimaryContainer"
                    style="@style/Widget.Material3.Button"/>
                <com.google.android.material.button.MaterialButton
                    android:textAppearance="@style/TextAppearance.Material3.TitleLarge"
                    android:textColor="@color/colorOnPrimary"
                    android:id="@+id/card_step_sim"
                    android:paddingTop="14dp"
                    android:paddingBottom="14dp"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:minHeight="64dp"
                    android:text="@string/step_sim_title"
                    app:backgroundTint="@color/colorPrimary"
                    app:cornerRadius="16dp"
                    app:elevation="6dp"
                    app:icon="@drawable/ic_walk"
                    app:iconGravity="textStart"
                    app:iconPadding="14dp"
                    app:iconSize="32dp"
                    app:iconTint="@color/colorOnPrimary"
                    app:rippleColor="@color/colorPrimaryContainer"
                    style="@style/Widget.Material3.Button"/>
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_route_create"
                    android:focusable="true"
                    android:clickable="true"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:cardElevation="2dp"
                    app:cardUseCompatPadding="true">
                    <TextView
                        android:gravity="center_vertical"
                        android:padding="20dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="绘制路线"
                        app:drawableStartCompat="@drawable/ic_map"
                        style="@style/TextAppearance.Material3.TitleMedium"/>
                </com.google.android.material.card.MaterialCardView>
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_settings"
                    android:focusable="true"
                    android:clickable="true"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:cardElevation="2dp"
                    app:cardUseCompatPadding="true">
                    <TextView
                        android:gravity="center_vertical"
                        android:padding="20dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/app_settings"
                        app:drawableStartCompat="@drawable/ic_menu_settings"
                        style="@style/TextAppearance.Material3.TitleMedium"/>
                </com.google.android.material.card.MaterialCardView>
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_dev"
                    android:focusable="true"
                    android:clickable="true"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:cardElevation="2dp"
                    app:cardUseCompatPadding="true">
                    <TextView
                        android:gravity="center_vertical"
                        android:padding="20dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/nav_menu_dev"
                        app:drawableStartCompat="@drawable/ic_menu_dev"
                        style="@style/TextAppearance.Material3.TitleMedium"/>
                </com.google.android.material.card.MaterialCardView>
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/home_card_qq"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:cardElevation="2dp"
                    app:cardUseCompatPadding="true">
                    <LinearLayout
                        android:orientation="vertical"
                        android:padding="16dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <TextView
                            android:textColor="?attr/colorPrimary"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/license_qq_group_title"
                            style="@style/TextAppearance.Material3.TitleSmall"/>
                        <TextView
                            android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                            android:textColor="?android:attr/textColorPrimary"
                            android:id="@+id/home_qq_text"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"/>
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/home_qq_copy"
                            android:visibility="gone"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="@string/license_qq_copy_group_number"
                            style="@style/Widget.Material3.Button.OutlinedButton"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp">
                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/home_bottom_image"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:src="@drawable/img_home_bottom"
                        android:scaleType="fitCenter"
                        android:adjustViewBounds="true"
                        android:contentDescription="@null"
                        android:importantForAccessibility="no"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintWidth_percent="0.25"
                        app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.Home.BottomImage"
                        app:strokeWidth="0dp"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <TextView
                    android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                    android:textColor="?android:attr/textColorSecondary"
                    android:gravity="center"
                    android:paddingBottom="20dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/home_footer_disclaimer"
                    android:lineSpacingMultiplier="1.2"/>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
